{
  "name": "saltmarket",
  "version": "1.0.0",
  "description": "SaltMarket - a mock e-commerce store selling gourmet salt, backed by Postgres, built for Playwright test practice",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "runtest": "npx playwright test --headed",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2"
  }
}
